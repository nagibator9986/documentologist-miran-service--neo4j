# ═══════════════════════════════════════════════════════════════
# Miran Service — environment configuration
# Copy to .env and fill in the required values marked with (!)
# ═══════════════════════════════════════════════════════════════

# ── App ──────────────────────────────────────────────────────
APP_ENV=prod
LOG_LEVEL=INFO
PORT=8001

# ── PostgreSQL (!) ───────────────────────────────────────────
POSTGRES_USER=miran
POSTGRES_PASSWORD=change_me_strong_password

# ── MinIO / S3 (!) ───────────────────────────────────────────
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio_secret

# ── Neo4j (!) ────────────────────────────────────────────────
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j_password

# ── Ollama ───────────────────────────────────────────────────
# If Ollama runs on host machine (outside Docker), use host.docker.internal
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_EMBEDDING_MODEL=bge-m3:latest
OLLAMA_TIMEOUT=120

# ── Qdrant ───────────────────────────────────────────────────
QDRANT_COLLECTION=bank_knowledge
QDRANT_VECTOR_SIZE=1024

# ── OCR Service ──────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
OCR_TIMEOUT_SECONDS=300
OCR_RETRY_DELAY_SECONDS=60
OCR_CONCURRENCY_LIMIT=1

# ── bank_knowledge Indexer ───────────────────────────────────
CHUNK_MAX_CHARS=2000
CHUNK_OVERLAP_CHARS=200
CHUNK_MIN_CHARS=100

# ── LangGraph Agent ──────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]
MAX_TOKENS_RESPONSE=2048
TEMPERATURE=0.1
MIN_RELEVANCE_SCORE=0.25
