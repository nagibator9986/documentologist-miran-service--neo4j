# ─────────────────────────────────────────────────────────────────────────────
# Miran LangGraph Agent — Environment Variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=langgraph-agent
APP_ENV=dev                          # dev | prod
LOG_LEVEL=INFO                       # DEBUG | INFO | WARNING | ERROR
PORT=8001
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501"]

# ── Ollama (LLM + Embeddings) ─────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
# Best choice for Russian + structured JSON output. Alternatives: llama3.1:8b, mistral:latest
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=bge-m3:latest
# Seconds before an Ollama request times out (raise if model is large/slow)
OLLAMA_TIMEOUT=120
# Faster model for bulk generation (e.g. document drafts). Empty = use OLLAMA_MODEL.
OLLAMA_GENERATE_DRAFT_MODEL=
# Max retries for Ollama LLM calls (tenacity exponential backoff)
OLLAMA_MAX_RETRIES=3

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=                    # Only for Qdrant Cloud
QDRANT_COLLECTION=bank_knowledge
# Candidates fetched before BM25 + reranking (more = better recall, slower)
QDRANT_TOP_K=40
QDRANT_TIMEOUT=30
# Named vector key used in dual-vector collections (set by indexer)
QDRANT_NAMED_VECTOR=q_vec
# Max scroll batches for full-collection scan (200 records/batch)
QDRANT_MAX_SCAN_BATCHES=50

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password              # CHANGE IN PRODUCTION
NEO4J_MAX_CONNECTION_POOL_SIZE=50
# Fulltext index name on Section.text_preview
NEO4J_FULLTEXT_INDEX=sectionText

# ── PostgreSQL (long-term memory) ─────────────────────────────────────────────
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/agent_memory
POSTGRES_TIMEOUT=10
# asyncpg connection pool tuning
PG_POOL_MIN_SIZE=1
PG_POOL_MAX_SIZE=5
# Thread pool workers for sync-to-async PG bridge
PG_THREAD_WORKERS=2

# ── Redis (short-term session memory) ────────────────────────────────────────
REDIS_URL=redis://localhost:6379
SESSION_TTL_SECONDS=3600

# ── MinIO (document export storage) ──────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin          # CHANGE IN PRODUCTION
MINIO_BUCKET=agent-exports
MINIO_SECURE=false
# Public-facing MinIO URL for presigned URLs (inside Docker: minio:9000 is not browser-reachable)
# Set to your public domain or localhost:9000 for dev
MINIO_PUBLIC_ENDPOINT=

# ── Document paths ────────────────────────────────────────────────────────────
EXPORT_DIR=/tmp/agent_exports
# Absolute path to folder containing Surya OCR JSON uploads (bank_knowledge service)
# BANK_KNOWLEDGE_UPLOAD_DIR=/path/to/bank_knowledge/app/uploads

# ── Agent behaviour ───────────────────────────────────────────────────────────
RERANK_TOP_K=7                       # Final docs passed to LLM after cross-encoder reranking
BM25_TOP_K=40                        # BM25 pool size (should equal QDRANT_TOP_K)
MAX_TOKENS_RESPONSE=2048
TEMPERATURE=0.1
# Minimum cosine score to keep a Qdrant hit (0-1). Lower = more recall.
MIN_RELEVANCE_SCORE=0.35
# Total pipeline timeout per request (seconds)
GRAPH_TIMEOUT_SECONDS=180
# Prior conversation turns passed to each LLM call
HISTORY_TURNS=3
# Minimum sigmoid-normalised rerank score (calibrated for Russian legal text)
SEARCH_MIN_CONFIDENCE=0.15
# Hard candidate pool for cross-encoder before top_k selection
RERANK_CANDIDATE_POOL=30
# Legacy multiplier (kept for backward compat)
RERANK_CANDIDATE_MULTIPLIER=2
# Seconds before graph enrichment (Neo4j) times out
GRAPH_ENRICHMENT_TIMEOUT=8.0
# Max tokens for supervisor intent classification
SUPERVISOR_NUM_PREDICT=32
# Char threshold above which query is treated as pasted document
VERIFY_PASTED_DOC_THRESHOLD=300
# Qdrant hits for analyze/summary tasks (broad coverage needed)
ANALYZE_SUMMARY_LIMIT=15
# Qdrant hits per side in analyze/compare tasks
ANALYZE_COMPARE_LIMIT=8
# Messages loaded from Redis at request start
MEMORY_MAX_HISTORY=20
# Worker threads for parallel Neo4j graph queries
GRAPH_POOL_WORKERS=5

# ── Reranker ─────────────────────────────────────────────────────────────────
# Primary multilingual cross-encoder (mMARCO, 13 languages incl. Russian)
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Fallback cross-encoder if primary fails to load
RERANKER_FALLBACK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
# Max characters of content fed to the cross-encoder per chunk
RERANKER_MAX_CONTENT=1024

# ── Integration: OCR Service ────────────────────────────────────────────────
# Base URL of the Surya OCR service (first step in ingest pipeline)
OCR_SERVICE_URL=http://localhost:8000
# Maximum file upload size in megabytes
MAX_UPLOAD_SIZE_MB=50

# ── SSE Streaming ───────────────────────────────────────────────────────────
# Words per SSE token event when streaming final response
SSE_WORD_CHUNK_SIZE=6

# ── Observability ──────────────────────────────────────────────────────────
MLFLOW_ENABLED=true                  # Enable MLflow tracing (disable with false to save resources)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=miran-agent
LOG_FORMAT=text                      # text | json (use json for production structured logging)

# ── Text truncation ───────────────────────────────────────────────────────────
GRAPH_KW_MAX_WORDS=10
CONTENT_SNIPPET_MAX_LEN=800
CITATION_PREVIEW_MAX_LEN=200
