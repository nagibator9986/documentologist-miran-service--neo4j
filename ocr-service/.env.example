# =============================================================
# Документолог — пример конфигурации
# Скопируй в .env и замени значения под своё окружение
# =============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=docolog
POSTGRES_PASSWORD=docolog_secret
POSTGRES_DB=documentolog

# ── MinIO ────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# ── OCR ──────────────────────────────────────────────────────
# Максимальное число параллельных OCR-задач (1 = без параллелизма, рекомендуется для CPU)
OCR_CONCURRENCY_LIMIT=1
# Таймаут одной OCR-задачи в секундах
OCR_TIMEOUT_SECONDS=300
# Задержка перед повторной попыткой OCR при ошибке
OCR_RETRY_DELAY_SECONDS=60

# ── Загрузка файлов ──────────────────────────────────────────
# Максимальный размер одного загружаемого файла в мегабайтах
MAX_UPLOAD_SIZE_MB=50

# ── Приложение ───────────────────────────────────────────────
# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Разрешённые CORS-источники (через запятую или JSON-массив)
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# ── Chunker Service ──────────────────────────────────────────
# Максимальный размер чанка в символах (~500 токенов для RU/KZ)
CHUNK_MAX_CHARS=2000
# Символов перекрытия между соседними чанками (~50 токенов)
CHUNK_OVERLAP_CHARS=200
# Минимальный размер абзаца — меньшие сливаются с соседом
CHUNK_MIN_CHARS=100
# Интервал опроса БД в секундах
CHUNK_POLL_INTERVAL=5

# ── Для локального запуска вне Docker (хосты = localhost) ────
# Внутри Docker эти переменные перезаписываются compose-файлом
# автоматически (postgres:5432, minio:9000 и т.д.) — не меняй
DATABASE_URL=postgresql+asyncpg://docolog:docolog_secret@localhost:5433/documentolog
DATABASE_URL_SYNC=postgresql://docolog:docolog_secret@localhost:5433/documentolog
PREFECT_API_URL=http://localhost:4200/api
